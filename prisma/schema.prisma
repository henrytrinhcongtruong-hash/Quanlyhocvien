generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================
// HỌC SINH
// =========================================
model Student {
  id        Int       @id @default(autoincrement())
  hoTen     String
  tenGoi    String?
  ngaySinh  DateTime?
  gioiTinh  String    @default("Nam") // "Nam" | "Nữ"
  to        Int       // 1-4
  lop       String    @default("11AT3")
  avatar    String?   // Ảnh học sinh
  ghiChu    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  feeCollections FeeCollection[]
  attendances    Attendance[]
  dutyRosters    DutyRoster[]
  eventMembers   EventMember[]

  @@index([to])
  @@index([hoTen])
}

// =========================================
// THU QUỸ
// =========================================
model FeeCollection {
  id           Int       @id @default(autoincrement())
  studentId    Int
  kyThu        String    // "HK1" | "HK2" | "Cả Năm"
  soTien       Float
  hinhThucDong String    @default("Tiền Mặt") // "Tiền Mặt" | "Chuyển Khoản"
  trangThai    String    @default("Chưa Đóng") // "Đã Đóng" | "Chưa Đóng"
  ngayDong     DateTime?
  ghiChu       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, kyThu])
  @@index([kyThu])
  @@index([trangThai])
}

// =========================================
// CHI QUỸ
// =========================================
model Expense {
  id          Int      @id @default(autoincrement())
  danhSachChi String
  hangMucChi  String   // "Văn phòng phẩm" | "Hoạt động trường" | ...
  soLuong     Float    @default(1)
  donGia      Float
  thanhTien   Float    // = soLuong x donGia
  ngayChi     DateTime
  ghiChu      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([hangMucChi])
  @@index([ngayChi])
}

// =========================================
// ĐIỂM DANH
// (AttendanceSession cho mobile sẽ thêm ở giai đoạn 2
//  mà không cần sửa bảng này)
// =========================================
model Attendance {
  id          Int      @id @default(autoincrement())
  studentId   Int
  ngay        DateTime
  loai        String   // "Vắng có phép" | "Vắng không phép" | "Đi trễ"
  ghiChu      String?
  submittedBy Int?     // userId nộp (null nếu import)
  toId        Int      // tổ của học sinh - denormalized để lọc nhanh
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, ngay, loai])
  @@index([ngay])
  @@index([toId])
  @@index([studentId])
}

// =========================================
// LỊCH TRỰC NHẬT
// =========================================
model DutyRoster {
  id        Int      @id @default(autoincrement())
  tuan      String   // "2025-W34" hoặc khoảng ngày "21/08-25/08/2025"
  thu       String   // "Thứ 2" | "Thứ 3" | "Thứ 4" | "Thứ 5" | "Thứ 6"
  thuOrder  Int      // 2-6 để sort đúng thứ tự
  studentId Int
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tuan])
  @@index([studentId])
}

// =========================================
// SỰ KIỆN
// =========================================
model Event {
  id                Int       @id @default(autoincrement())
  tenSuKien         String
  hangMuc           String?
  chiTiet           String?
  deadline          DateTime?
  ketHoachTrienKhai String?
  trangThai         String    @default("Sắp diễn ra") // "Sắp diễn ra" | "Đang diễn ra" | "Đã xong"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  members EventMember[]

  @@index([deadline])
  @@index([trangThai])
}

model EventMember {
  id        Int    @id @default(autoincrement())
  eventId   Int
  studentId Int
  vaiTro    String @default("Support") // "Lead" | "Support" | "User"

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([studentId])
}

// =========================================
// LỊCH THI & KIỂM TRA
// =========================================
model ExamSchedule {
  id          Int      @id @default(autoincrement())
  monHoc      String   // "Toán", "Ngữ Văn", "Tiếng Anh", "Vật Lý", "Hóa Học", "Sinh Học", "Lịch Sử", "Địa Lý", "GDCD", "Tin Học"...
  tenKyThi    String   // "Kiểm tra 15 phút", "Kiểm tra 1 tiết", "Thi Giữa Kỳ I", "Thi Cuối Kỳ I"...
  loaiKyThi   String   @default("Giữa Kỳ") // "15 Phút" | "1 Tiết" | "Giữa Kỳ" | "Cuối Kỳ" | "Thi Thử"
  ngayThi     DateTime
  gioThi      String   @default("07:30") // "07:30", "08:15", "13:30"...
  thoiLuong   Int      @default(45)      // Thời lượng phút (15, 45, 60, 90, 120)
  hinhThuc    String   @default("Trắc nghiệm") // "Trắc nghiệm" | "Tự luận" | "Trắc nghiệm + Tự luận" | "Thực hành" | "Vấn đáp"
  phongThi    String?  // "Phòng 201", "Hội trường A", "Phòng Tin học 1"
  giamThi     String?  // "Thầy Nguyễn Văn A"
  phamViOnTap String?  // "Chương 1, 2 bài 1-8"
  lop         String   @default("11AT3") // "11AT3" | "12T2" | "ALL"
  ghiChu      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lop])
  @@index([ngayThi])
  @@index([monHoc])
  @@index([loaiKyThi])
}

// =========================================
// THỜI KHÓA BIỂU
// =========================================
model Timetable {
  id          Int      @id @default(autoincrement())
  thu         Int      // 2 (Thứ 2) -> 7 (Thứ 7)
  tiet        Int      // 1 -> 10
  buoi        String   @default("Sáng") // "Sáng" | "Chiều"
  thoiGian    String?  // "07:15 - 08:00"
  monHoc      String   // "Toán Học", "Ngữ Văn", "Tiếng Anh"...
  giaoVien    String?  // "Thầy Tuấn", "Cô Lan"...
  phongHoc    String?  // "Phòng 201", "Phòng Tin học 1"...
  lop         String   @default("11AT3")
  hocKy       String   @default("HK1") // "HK1" | "HK2"
  ghiChu      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([lop, hocKy, thu, tiet])
  @@index([lop])
  @@index([thu])
  @@index([hocKy])
}

// =========================================
// SƠ ĐỒ LỚP HỌC (SEATING CHART)
// =========================================
model SeatingChart {
  id          Int      @id @default(autoincrement())
  lop         String   @default("12T2")
  title       String   @default("CLASSROOM SEATING CHART")
  gvcn        String?  @default("Phí Huỳnh Anh Hào")
  slogan      String?  @default("Kỷ Cương - Trách Nhiệm - Hiệu Quả - Phát Triển")
  month       String   @default("Tháng 09/2025")
  slotsData   String   // JSON string chứa mảng 56 vị trí chỗ ngồi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lop])
  @@index([month])
}

// =========================================
// USER & PHÂN QUYỀN
// =========================================
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  passwordHash  String
  plainPassword String?  // Mật khẩu hiển thị cho Admin quản lý
  hoTen         String
  roleLabel     String   @default("")
  assignedLop   String   @default("11AT3")
  isSuperAdmin  Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  permissions UserPermission[]

  @@index([username])
  @@index([isSuperAdmin])
}

// Phân quyền chi tiết theo module/user
// Mỗi user tối đa 6 dòng (1 dòng / module)
// Module không có dòng = mặc định "khong_co_quyen"
model UserPermission {
  id         Int    @id @default(autoincrement())
  userId     Int
  module     String // "hoc_sinh"|"diem_danh"|"su_kien"|"bao_cao"|"quy"|"lich_truc"
  level      String @default("khong_co_quyen") // "khong_co_quyen"|"chi_xem"|"toan_quyen"
  scope      String @default("toan_lop")       // "toan_lop"|"theo_to"
  scopeToIds String @default("[]")             // JSON: "[1,2,3,4]"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
}

// =========================================
// QUẢN LÝ LINK & KHÓA BẢO TRÌ TRANG
// =========================================
model PageLock {
  id          Int       @id @default(autoincrement())
  path        String    @unique // "/", "/so-do-lop", "/thoi-khoa-bieu", "/quy-lop", "/lich-thi", "/lich-truc", "/su-kien", "/diem-danh-cua-toi", "/dang-ky"
  title       String    // "Trang chủ", "Sơ đồ lớp", ...
  description String?   // Mô tả trang
  isLocked    Boolean   @default(false)
  lockReason  String?   @default("Hệ thống đang được nâng cấp tính năng mới. Vui lòng quay lại sau ít phút!")
  lockUntil   DateTime? // Thời gian dự kiến mở khóa
  lockedBy    String?   // Username của admin thực hiện khóa
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([path])
  @@index([isLocked])
}
